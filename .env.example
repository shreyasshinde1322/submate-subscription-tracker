# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# PostgreSQL connection string. Set this in your local .env and in the Vercel
# project environment variables. Never commit a real value to source control.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Set to false only for local PostgreSQL without TLS
PG_SSL=true

# ---------------------------------------------------------------------------
# Sessions (optional — sensible defaults shown)
# ---------------------------------------------------------------------------
# Session lifetime in hours (default 168 = 7 days).
# SESSION_TTL_HOURS=168
# Cookie name (default submate_session).
# SESSION_COOKIE_NAME=submate_session
# Force Secure cookies on/off. Defaults to on when NODE_ENV=production or VERCEL.
# COOKIE_SECURE=true
# SameSite policy: strict (default) or lax.
# COOKIE_SAME_SITE=strict

# ---------------------------------------------------------------------------
# CORS / CSRF (optional)
# ---------------------------------------------------------------------------
# Comma-separated trusted browser origins for cross-origin deployments (no
# wildcard; credentials are enabled). Local development always trusts the Vite
# origin (http://localhost:5173) and its 127.0.0.1 form. On Vercel the project's
# own deployment URLs are trusted automatically. Set this only for an extra
# custom domain that serves the frontend from a different origin than the API.
# CORS_ORIGIN=https://your-app.vercel.app,https://app.example.com
# Optional: override the Vite dev proxy target (default http://localhost:3001).
# VITE_API_TARGET=http://localhost:3001

# ---------------------------------------------------------------------------
# Rate limiting on /api/auth/login and /api/auth/register (optional)
# ---------------------------------------------------------------------------
# LOGIN_RATE_LIMIT=10
# REGISTER_RATE_LIMIT=5
# AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# ---------------------------------------------------------------------------
# Local server (optional)
# ---------------------------------------------------------------------------
# SUBMATE_PORT=3001
# HOST=0.0.0.0
